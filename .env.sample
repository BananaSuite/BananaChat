# BananaChat configuration example. Every setting is optional; the values
# shown are the defaults. See docs/configuration.md for explanations.
# Managed installations keep these in /opt/bananachat/config/app.env.

# --- Network and security ---
# BC_HOST=127.0.0.1
# BC_PORT=8000
# BC_PROXY_MODE=0
# BC_PROXY_HOPS=1
# BC_SECURE_COOKIES=0            # defaults to the value of BC_PROXY_MODE
# BC_SESSION_COOKIE_NAME=bc_session
# BC_SESSION_DAYS=7
# BC_SECRET_KEY=                 # generated into <instance>/.secret_key when unset
# BC_SETUP_TOKEN=                # derived from the secret key when unset
# BC_PASSWORD_HASH_METHOD=auto
# BC_MIN_FORM_SECONDS=0.4
# BC_SOURCE_URL=https://github.com/BananaSuite/BananaChat
# BC_ENV=production
# BC_DEFAULT_LANGUAGE=it

# --- Storage and logs ---
# BC_INSTANCE_DIR=./instance
# BC_DATABASE_PATH=./instance/bananachat.db
# BC_LOG_FILE=./instance/bananachat.log
# BC_LOGGING_LEVEL=verbose
# BC_DB_BUSY_TIMEOUT_MS=5000
# BC_DB_CACHE_KIB=4096
# BC_DB_SYNCHRONOUS=FULL

# --- Inference ---
# BC_OLLAMA_URL=http://127.0.0.1:11434
# BC_OLLAMA_API_KEY=
# Whether Ollama runs on this machine; unset = automatic (a key or a
# non-loopback URL means a remote compute server).
# BC_INFERENCE_LOCAL=
# BC_OLLAMA_SYNC_INTERVAL=60
# BC_KEEP_ALIVE=0
# BC_MAX_CONCURRENT=4
# BC_MAX_QUEUE_DEPTH=50
# BC_QUEUE_TIMEOUT=120
# BC_GENERATION_TIMEOUT=300
# BC_FIRST_TOKEN_TIMEOUT=180
# BC_INFERENCE_READ_TIMEOUT=30
# BC_MAX_OUTPUT_TOKENS=8192
# BC_MAX_NUM_CTX=32768
# BC_MIN_FREE_MEMORY_MB=256
# BC_HTTP_THREADS=16
# BC_WORKERS=2
# BC_INFERENCE_OUTAGE_MODE=shutdown
# No default: fallback mode needs an explicit URL, and gets its own key
# (the compute token in BC_OLLAMA_API_KEY is never sent to it).
# BC_INFERENCE_FALLBACK_URL=
# BC_INFERENCE_FALLBACK_API_KEY=
# BC_INFERENCE_HEALTH_INTERVAL=15
# BC_INFERENCE_HEALTH_FAILURES=3
# BC_WORKERS_ENABLED=0
# BC_WORKER_CLAIM_TIMEOUT=20
# BC_OLLAMA_MODEL_DIR=~/.ollama/models
# BC_MIN_FREE_DISK_GB=2

# --- Chats and uploads ---
# BC_CHAT_MAX_FILES=4
# BC_CHAT_MAX_REQUEST_MB=8
# BC_CHAT_MAX_IMAGE_MB=5
# BC_CHAT_MAX_IMAGE_PIXELS=20000000
# BC_CHAT_MAX_DOCUMENT_MB=5
# BC_CHAT_MAX_TEXT_KB=1024
# BC_CHAT_MAX_EXTRACTED_CHARS=200000
# BC_CHAT_MAX_SESSION_ATTACHMENT_MB=40
# BC_CHAT_MAX_CONTEXT_CHARS=300000
# BC_CHAT_MAX_CONTEXT_IMAGES=8
# BC_CHAT_MAX_HISTORY_MESSAGES=100
# BC_CHAT_MAX_RESPONSE_KB=1024
# BC_BACKGROUND_IMAGE_MAX_MB=4
# BC_BACKGROUND_IMAGE_MAX_PIXELS=16000000
# BC_BACKGROUND_IMAGE_MAX_DIMENSION=2560

# --- Retention ---
# BC_NO_HISTORY_TTL_HOURS=24
# BC_DELETED_CHAT_RETENTION_DAYS=30
# BC_METRICS_RETENTION_DAYS=30
# BC_COMPUTE_SNAPSHOT_INTERVAL=30

# --- Image generation (ComfyUI) ---
# BC_IMAGE_BACKEND=disabled
# BC_COMFYUI_URL=http://127.0.0.1:8188
# BC_COMFYUI_TIMEOUT=30
# BC_COMFYUI_QUEUE_TIMEOUT=300
# BC_COMFYUI_GENERATION_TIMEOUT=600
# BC_COMFYUI_POLL_INTERVAL=1
# BC_COMFYUI_SAMPLER=euler
# BC_COMFYUI_SCHEDULER=normal
# BC_COMFYUI_STEPS=20
# BC_COMFYUI_CFG=7
# BC_IMAGE_GENERATION_RPM=6
# BC_IMAGE_TOKENS_PER_GENERATION=5000
# BC_IMAGE_CREDITS_PER_GENERATION=5
# BC_IMAGE_CREDIT_RESERVATION_TTL=1200
# BC_IMAGE_CREDIT_RESERVATION_HEARTBEAT=30
# BC_CHECKPOINT_AGENT_URL=
# BC_CHECKPOINT_AGENT_TOKEN_FILE=
# BC_CHECKPOINT_AGENT_ALLOW_INSECURE_TAILSCALE=0

# Agents: coding agents in sandboxes on the compute host (docs/agents.md).
# The feature stays off until an administrator enables it in Admin -> Agents.
# BC_AGENTS_RUNNER_URL=
# BC_AGENTS_RUNNER_TOKEN_FILE=
# BC_AGENTS_RUNNER_TOKEN=
# BC_AGENTS_RUNNER_ALLOW_INSECURE_TAILSCALE=0
# BC_AGENTS_MAX_UPLOAD_MB=20
