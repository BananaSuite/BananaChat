# Listen on loopback unless a protected compute network requires otherwise.
BC_CHECKPOINT_AGENT_HOST=127.0.0.1
BC_CHECKPOINT_AGENT_PORT=8765

BC_CHECKPOINT_ROOT=/srv/comfyui/models/checkpoints
BC_CHECKPOINT_AGENT_STATE_DIR=/var/lib/bananachat-checkpoint-agent
BC_CHECKPOINT_AGENT_TOKEN_FILE=/var/lib/bananachat-checkpoint-agent/api.token
# BC_CHECKPOINT_AGENT_HF_TOKEN_FILE=/var/lib/bananachat-checkpoint-agent/huggingface.token

BC_CHECKPOINT_AGENT_QUEUE_SIZE=4
BC_CHECKPOINT_AGENT_MAX_BYTES=107374182400
BC_CHECKPOINT_AGENT_DISK_RESERVE_BYTES=5368709120
BC_CHECKPOINT_AGENT_JSON_BODY_LIMIT=32768
BC_CHECKPOINT_AGENT_REQUEST_TIMEOUT=30
