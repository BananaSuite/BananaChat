# BananaChat local environment example
# Export these values before starting the service, or load an environment file
# with your process supervisor. See docs/deployment.md for HTTPS settings.
# All settings are optional; defaults are shown below.

# --- Networking ---
# BC_PORT=8000
# BC_HOST=127.0.0.1
# BC_PROXY_MODE=0

# --- Security ---
# SECRET_KEY=<auto-generated>
# BC_SESSION_COOKIE_NAME=bc_session
# BC_SECURE_COOKIES=1
# BC_PASSWORD_HASH_METHOD=auto

# --- UI customization backgrounds ---
# BC_BACKGROUND_IMAGE_MAX_MB=4
# BC_BACKGROUND_IMAGE_MAX_PIXELS=16000000
# BC_BACKGROUND_IMAGE_MAX_DIMENSION=2560

# --- Chat attachments ---
# BC_CHAT_MAX_FILES=4
# BC_CHAT_MAX_REQUEST_MB=8
# BC_CHAT_MAX_IMAGE_MB=5
# BC_CHAT_MAX_DOCUMENT_MB=5
# BC_CHAT_MAX_TEXT_KB=1024
# BC_CHAT_MAX_EXTRACTED_CHARS=200000
# BC_CHAT_MAX_IMAGE_PIXELS=20000000
# BC_CHAT_MAX_SESSION_ATTACHMENT_MB=40
# BC_CHAT_MAX_CONTEXT_CHARS=300000
# BC_CHAT_MAX_CONTEXT_IMAGES=8

# --- Database ---
# BC_DATABASE_PATH=instance/bananachat.db

# --- Ollama ---
# BC_OLLAMA_URL=http://127.0.0.1:11434
# BC_OLLAMA_SYNC_INTERVAL=60
# BC_KEEP_ALIVE=0

# --- Experimental image generation ---
# BC_IMAGE_BACKEND=disabled
# BC_COMFYUI_URL=http://127.0.0.1:8188
# BC_COMFYUI_GENERATION_TIMEOUT=600
# BC_COMFYUI_QUEUE_TIMEOUT=300
# BC_IMAGE_GENERATION_RPM=6
# BC_IMAGE_CREDITS_PER_GENERATION=5
# BC_IMAGE_CREDIT_RESERVATION_TTL=1200
# Optional checkpoint pull agent; both settings are required. The token file
# must be a regular, non-symlink mode-0600 file readable by the web process.
# BC_CHECKPOINT_AGENT_URL=http://127.0.0.1:8765
# BC_CHECKPOINT_AGENT_TOKEN_FILE=/run/secrets/bananachat-checkpoint-agent-token
# Remote agents require HTTPS. Direct HTTP to a Tailscale IP or *.ts.net host
# is rejected unless this explicit, insecure transport exception is enabled:
# BC_CHECKPOINT_AGENT_ALLOW_INSECURE_TAILSCALE=0

# --- Queue ---
# BC_MAX_CONCURRENT=4
# BC_MAX_QUEUE_DEPTH=50
# BC_MIN_FREE_MEMORY_MB=1024

# --- Compute snapshots ---
# BC_COMPUTE_SNAPSHOT_INTERVAL=30

# --- Logging ---
# BC_LOGGING_LEVEL=verbose
# BC_LOG_FILE=instance/bananachat.log

# --- Instance ---
# BC_INSTANCE_DIR=instance
